[ext_resource type="Script" path="res://godot/scripts/resources/locale_pack_data.gd" id="1_locpack"]

[resource]
script = ExtResource("1_locpack")
locale_code = "id"
locale_name = "Bahasa Indonesia"
strings = {
	"ach.always_more_austerity.desc": "Puaskan hati [color=__CLR_INFO_BLUE__][b]IMF[/b][/color] dengan mencabut subsidi BBM dan listrik, membongkar monopoli BULOG, dan melikuidasi bank-bank bangkrut sembari mencapai Posisi Internasional tertinggi saat Kesehatan Ekonomi dan Popularitas hancur lebur (Sedang+).",
	"ach.always_more_austerity.title": "Tanggapan Presiden Habibie, seperti biasa, adalah pengetatan anggaran lagi.",
	"ach.aman_terkendali.desc": "Capai tingkat Stabilitas Nasional tertinggi ('$tier.stab.uneasy_calm$') pada tingkat kesulitan Sedang atau lebih tinggi. Semuanya aman dan terkendali, seperti kata pepatah lama. Mohon jangan mengintip ke bawah karpet.",
	"ach.aman_terkendali.title": "Aman Terkendali™",
	"ach.asas_tunggal_restored.desc": "Berlakukan kembali UU Asas Tunggal 1985 di bawah keadaan darurat dan bubarkan blok partai-partai keagamaan di dalam MPR.",
	"ach.asas_tunggal_restored.title": "Pancasila Abadi!",
	"ach.back_to_the_barracks.desc": "Hapus 38 kursi MPR tanpa pemilihan milik ABRI dan bongkar struktur komando teritorial Kodam dalam satu kampanye yang sama.",
	"ach.back_to_the_barracks.title": "Kembali ke Barak",
	"ach.baligate_clean.desc": "Bongkar tuntas skandal Bank Bali. Bekukan rekening EGP, berikan PwC akses tanpa batas, serahkan berkas tanpa sensor kepada Pansus PDI-P, dan buka status rahasia laporan audit lengkapnya.",
	"ach.baligate_clean.title": "546 Miliar Alasan",
	"ach.beringin_tumbang.desc": "Diskualifikasi kaukus barisan tua Golkar pimpinan Akbar Tandjung atas hasil audit kecurangan dana pemilu Bank Bali.",
	"ach.beringin_tumbang.title": "Memangkas Pohon Beringin",
	"ach.bhinneka_coalition.desc": "Selesaikan Sidang Umum MPR dengan PDI-P, Poros Tengah, Golkar (DPP Slipi), dan TNI semuanya berada pada tingkat loyalitas 60 atau lebih tinggi.",
	"ach.bhinneka_coalition.title": "Bhinneka Tunggal Ika",
	"ach.bruning_impressed.desc": "Selamat melewati Sidang Umum MPR setelah memberlakukan ketiga mandat IMF, mencapai Posisi Internasional tertinggi, serta menghancurkan Kesehatan Ekonomi dan Popularitas. (Kesulitan Apa Pun)",
	"ach.bruning_impressed.title": "Brüning Terkesan.",
	"ach.camdessus_arms.desc": "Hidupkan kembali Skema Dewan Mata Uang (CBS) Steve Hanke, lawan ultimatum Bank Bali dari IMF, dan tetap selesaikan permainan dengan Kesehatan Ekonomi setidaknya pada tingkat '$tier.econ.stagnant$'.",
	"ach.camdessus_arms.title": "Siapa yang Lipat Tangan Sekarang, Michel?",
	"ach.cendana_cashback.desc": "Sita jalan tol Cendana, audit yayasan Kodam, dan bentuk mahkamah penyitaan aset Soeharto. Tolong siapkan kuitansinya.",
	"ach.cendana_cashback.title": "Cashback Cendana",
	"ach.cendana_zero.desc": "Berantas habis Pengaruh Cendana sepenuhnya pada tingkat kesulitan Sedang atau lebih tinggi.",
	"ach.cendana_zero.title": "Cendana Delenda Est",
	"ach.cleared_for_takeoff.desc": "Lindungi pendanaan riset BPPT/IPTN DAN perjuangkan pos anggaran pesawat turboprop N-250 Gatotkaca, lalu menangkan Sidang Umum MPR.",
	"ach.cleared_for_takeoff.title": "Siap Lepas Landas, Gatotkaca",
	"ach.complete_run.desc": "Selesaikan satu permainan penuh hingga Sidang Umum MPR berakhir, apa pun hasilnya.",
	"ach.complete_run.title": "Hari ke-512",
	"ach.deja_vu_322.desc": "Kalah dalam Sidang Umum MPR dengan perolehan suara yang nyaris persis sama dengan penolakan 322–355 yang dialami Habibie di dunia nyata pada malam 19–20 Oktober 1999.",
	"ach.deja_vu_322.title": "355 Lawan 322: Déjà Vu Sejarah",
	"ach.dipecat_dengan_hormat.desc": "Kalah dalam Sidang Umum MPR saat Stabilitas Pemerintahan secara keseluruhan berada pada tingkat $gov.stable$ atau $gov.secure$.",
	"ach.dipecat_dengan_hormat.title": "Diberhentikan dengan Hormat",
	"ach.dwifungsi_kaput.desc": "Pisahkan POLRI dari ABRI, perluas wewenang Komnas HAM atas militer, dan tetap menangkan pemungutan suara MPR.",
	"ach.dwifungsi_kaput.title": "Selamat Tinggal Dwifungsi",
	"ach.empire_strikes_beringin.desc": "Sahkan RUU milisi Kamra, berlakukan kembali sensor pers SIUPP, bersihkan Utusan Golongan, dan mobilisasi Pam Swakarsa. Dahulu kala, di sebuah rezim yang tak begitu jauh...",
	"ach.empire_strikes_beringin.title": "Kembalinya Sang Beringin",
	"ach.enak_jamanku.desc": "Menangkan Sidang Umum MPR dengan Pengaruh Cendana mendekati $tier.cendana.untouchable$ dan Kredibilitas Reformasi merosot ke tingkat '$tier.ref.authoritarian$' atau '$tier.ref.new_order_crony$'.",
	"ach.enak_jamanku.title": "\"Piye Kabare? Enak Jamanku Toh?\"",
	"ach.et_tu_akbar.desc": "Kalah dalam Sidang Umum MPR meskipun memegang loyalitas '$mood.golkar_habibie.ride_or_die$' dari kubu Golkar Loyalis Anda akibat ditinggalkan oleh faksi Golkar pimpinan Akbar Tandjung.",
	"ach.et_tu_akbar.title": "Et Tu, Akbar?",
	"ach.finis_dwifungsi.desc": "Bentuk kementerian pertahanan sipil, pisahkan POLRI dari ABRI, bongkar struktur komando Kodam, dan hapus kursi MPR milik ABRI. Cilangkap telah membaca pesan Anda dan sedang menyusun balasannya.",
	"ach.finis_dwifungsi.title": "Tombol Hapus Dwifungsi",
	"ach.fumes_in_the_tank.desc": "Masuki Sidang Umum MPR dengan nol Modal Politik tersisa dan tetap menangkan kursi kepresidenan.",
	"ach.fumes_in_the_tank.title": "Melayang Tanpa Bahan Bakar",
	"ach.gus_dur_twist.desc": "Bantu Amien Rais menjadi Ketua MPR, bangun sikap '$mood.poros_tengah_merged.leaning_toward_habibie$' (atau lebih baik) dengan Poros Tengah, namun tetap kalah dalam Pemungutan Suara Pertanggungjawaban.",
	"ach.gus_dur_twist.title": "Lho! Tunggu, Itu Musiknya Gus Dur!",
	"ach.habibi_ya_habibi.desc": "Menangkan Sidang Umum MPR dengan dukungan melimpah dari Poros Tengah, Utusan Golongan, dan Partai-Partai Kecil.",
	"ach.habibi_ya_habibi.title": "Habibi, Ya Habibi!",
	"ach.halo_andi.desc": "Pertahankan surat perintah SP3 11 Oktober yang menghentikan penyidikan korupsi Soeharto saat Pengaruh Cendana masih berada pada tingkat $tier.cendana.entrenched$ atau $tier.cendana.untouchable$.",
	"ach.halo_andi.title": "\"Halo, Andi? Apa Kabar?\"",
	"ach.halo_halo_senayan.desc": "Hubungi lewat telepon setiap malam menjelang penentuan: gunakan Seruan Terakhir pada masing-masing dari tiga fase tindakan terakhir.",
	"ach.halo_halo_senayan.title": "Halo, Halo Senayan",
	"ach.kaos_merah.desc": "Menangkan Sidang Umum MPR meskipun Mobilisasi Massa Jalanan PDI-P mencapai 100% dan blok tersebut memilih menolak hingga utusan terakhir.",
	"ach.kaos_merah.title": "Baju Merah Saja Tak Cukup",
	"ach.khatam.desc": "Menangkan Sidang Umum MPR pada seluruh tingkat kesulitan standar: Mudah, Sedang, Sulit, dan Historis. Ibarat menamatkan seluruh isi buku dari sampul ke sampul.",
	"ach.khatam.title": "Khatam!",
	"ach.kudatuli_redux.desc": "Bubarkan PDI-P pimpinan Megawati melalui dekrit darurat dan bagikan 153 kursinya ke seluruh Majelis.",
	"ach.kudatuli_redux.title": "27 Juli Terulang Kembali",
	"ach.lose_decisive.desc": "Telan kekalahan telak dalam Sidang Umum MPR.",
	"ach.lose_decisive.title": "Akhir Sebuah Era",
	"ach.lose_narrow.desc": "Kehilangan kursi kepresidenan dengan selisih suara setipis silet.",
	"ach.lose_narrow.title": "Perjuangan yang Gagah Berani",
	"ach.lose_overwhelming.desc": "Kalah dalam Sidang Umum MPR dengan selisih suara mutlak yang menolak Anda (Di bawah 200 suara).",
	"ach.lose_overwhelming.title": "Penolakan Total",
	"ach.mr_crack.desc": "Biarkan Stabilitas Pemerintahan secara keseluruhan jatuh ke tingkat GOYAH atau RUNTUH, lalu rancang pemulihan struktural dan menangkan Sidang Umum MPR.",
	"ach.mr_crack.title": "Mr. Crack Tak Pernah Retak",
	"ach.ngopi_dulu.desc": "Menangkan Sidang Umum MPR tanpa membuat para jenderal marah ataupun terasing. Ngopi dulu, Jenderal.",
	"ach.ngopi_dulu.title": "Ngopi Dulu, Jenderal?",
	"ach.nkri_terms.desc": "Berlakukan otonomi daerah, undang-undang keistimewaan Aceh, serta pemekaran Maluku dan Irian Jaya. Negara kesatuan memang harga mati, kecuali untuk bagian-bagian yang sudah telanjur dinegosiasikan.",
	"ach.nkri_terms.title": "NKRI Harga Mati (Syarat dan Ketentuan Berlaku)",
	"ach.odd_bedfellows.desc": "Menangkan Sidang Umum MPR saat PDI-P dan Poros Tengah, yang selama ini berkoordinasi melawan Anda, sama-sama memiliki loyalitas 70 atau lebih tinggi.",
	"ach.odd_bedfellows.title": "Koalisi Tak Lazim",
	"ach.orba_jilid_dua.desc": "Berlakukan 'Supersemar II' sekaligus Pakta Pemulihan Jalan Cendana, dan selamat melewati Sidang Umum MPR.",
	"ach.orba_jilid_dua.title": "Orde Baru Jilid II",
	"ach.pdip_max.desc": "Rebut hati PDI-P pimpinan Megawati sepenuhnya pada tingkat kesulitan Sedang atau lebih tinggi.",
	"ach.pdip_max.title": "Kompromi Tak Terduga",
	"ach.persona_non_grata.desc": "Menangkan Sidang Umum MPR saat Posisi Internasional berada pada tingkat '$tier.intl.pariah_state$'.",
	"ach.persona_non_grata.title": "Persona Non Grata, Bapak Presiden",
	"ach.pop_max.desc": "Capai puncak Popularitas ('$tier.pop.tolerated$') pada tingkat kesulitan Sedang atau lebih tinggi.",
	"ach.pop_max.title": "Suara Hati Nurani Rakyat",
	"ach.presiden_rebahan.desc": "Menangkan Sidang Umum MPR tanpa memberlakukan satu pun Dekrit Luar Biasa. Mengurus negara itu melelahkan; terkadang, kebijakan terbaik adalah rebahan.",
	"ach.presiden_rebahan.title": "Presiden Rebahan",
	"ach.rainbow_coalition.desc": "Deklarasikan pemerintahan persatuan nasional bersama PDI-P, Golkar, Poros Tengah, dan ABRI.",
	"ach.rainbow_coalition.title": "Koalisi Pelangi",
	"ach.sedia_payung.desc": "Capai Sidang Umum MPR dengan Modal Politik pada batas maksimal (100).",
	"ach.sedia_payung.title": "Sedia Payung Sebelum Hujan",
	"ach.sinetron_villain.desc": "Menangkan Sidang Umum MPR saat Popularitas berada pada tingkat '$tier.pop.universally_hated$'.",
	"ach.sinetron_villain.title": "Antagonis Sinetron Menang",
	"ach.singa_reformasi.desc": "Menangkan Sidang Umum MPR dengan Kredibilitas Reformasi pada tingkat tertinggi dan Pengaruh Cendana ditekan ke tingkat $tier.cendana.weakened$ atau $tier.cendana.dormant$.",
	"ach.singa_reformasi.title": "SINGA Reformasi",
	"ach.siupp_is_back.desc": "Berlakukan kembali perizinan pers SIUPP.",
	"ach.siupp_is_back.title": "SIUPP Kembali Lagi, Bung",
	"ach.thankless_burden.desc": "Hormati hasil jajak pendapat Timor Timur 30 Agustus di setiap langkah, undang pasukan penjaga perdamaian PBB pada 12 September, dan tetap menangkan Sidang Umum MPR.",
	"ach.thankless_burden.title": "Peraih Nobel dalam Semangat",
	"ach.the_center_holds.desc": "Menangkan Sidang Umum MPR dengan mayoritas utusan mendukung Anda di kedua sayap Golkar, Utusan Daerah, Utusan Golongan, Partai-Partai Kecil, dan TNI.",
	"ach.the_center_holds.title": "Poros Utama Bertahan",
	"ach.those_who_stayed_silent.desc": "Kalah dalam Sidang Umum MPR dengan perolehan 330 hingga 350 suara menerima, di mana surat suara abstain dan utusan yang tidak hadirlah—bukan suara 'menolak'—yang menjauhkan Anda dari ambang 351 suara.",
	"ach.those_who_stayed_silent.title": "Mereka yang Memilih Diam",
	"ach.tolak_lupa.desc": "Peringati pahlawan Trisakti dan Semanggi, lakukan kunjungan rekonsiliasi ke Glodok, dukung Komnas Perempuan, cabut aturan SBKRI, buka arsip 1965, dan cabut larangan budaya Tionghoa.",
	"ach.tolak_lupa.title": "Menolak Lupa",
	"ach.total_reformasi.desc": "Berlakukan ketujuh pilar reformasi: undang-undang antikorupsi, netralitas pegawai negeri sipil, pemilihan presiden langsung, mahkamah penyitaan aset Soeharto, pembebasan tahanan politik, wewenang baru Komnas HAM, dan pembubaran Departemen Penerangan.",
	"ach.total_reformasi.title": "Reformasi Total, Bung!",
	"ach.ucn_6am.desc": "Pertahankan Pidato Pertanggungjawaban Anda pada mode Situasi Siaga Satu (SSS) dengan seluruh kartu situasi diatur ke Tingkat III.",
	"ach.ucn_6am.title": "Hak Pamer",
	"ach.unify_golkar.desc": "Rekonsiliasikan kedua sayap Golkar.",
	"ach.unify_golkar.title": "Satukan Golkar",
	"ach.utang_budi.desc": "Miliki setidaknya satu tabungan Budi Politik pada enam fraksi berbeda di saat yang bersamaan.",
	"ach.utang_budi.title": "Hutang Budi Dibawa Mati",
	"ach.utang_nanti_dulu.desc": "Menangkan Sidang Umum MPR saat Kesehatan Ekonomi berada pada tingkat '$tier.econ.bankruptcy$'.",
	"ach.utang_nanti_dulu.title": "Utang Bisa Nanti Dulu",
	"ach.win_any.desc": "Menangkan Sidang Umum MPR dan pertahankan kursi kepresidenan pada tingkat kesulitan apa pun.",
	"ach.win_any.title": "Bukan Lagi Presiden Transisi",
	"ach.win_comfortable.desc": "Menangkan Sidang Umum MPR dengan mayoritas suara yang aman (380+ suara).",
	"ach.win_comfortable.title": "Mayoritas Nyaman",
	"ach.win_historical.desc": "Lawankan arus sejarah dan menangkan Sidang Umum MPR pada tingkat kesulitan Historis.",
	"ach.win_historical.title": "Mandat Penuh Terkunci",
	"ach.win_narrow.desc": "Selamat melewati Sidang Umum MPR dengan kemenangan tipis yang mengejutkan.",
	"ach.win_narrow.title": "Lolos dari Lubang Jarum",
	"ach.win_overwhelming.desc": "Menangkan Sidang Umum MPR dengan selisih suara mutlak (450+ suara).",
	"ach.win_overwhelming.title": "Mandat Baru",
	"achievement.unlocked_title": "Pencapaian Terbuka!",
	"achievements.intro": "Tinjau pencapaian Anda di bawah ini.",
	"action.decrees_photo": "DEKRIT LUAR BIASA",
	"action.decrees_title": "Dekrit Luar Biasa",
	"action.exec_available": "Kita dapat menetapkan tindakan eksekutif atau dekrit.",
	"action.exec_used": "Kita tidak dapat menetapkan tindakan eksekutif atau dekrit lagi pada giliran ini.",
	"action.faction_available": "Kita boleh melakukan pendekatan dengan sebanyak mungkin fraksi pada giliran ini, tetapi setiap pendekatan menambah $STEP$ MP pada biaya pendekatan berikutnya.",
	"action.faction_used": "Kita telah melakukan $COUNT$ pendekatan fraksi pada giliran ini. Pendekatan berikutnya dikenai biaya tambahan sebesar $SURCHARGE$ PC.",
	"action.longknives_available": "Kita dapat menyampaikan satu Seruan Terakhir kepada Fraksi.",
	"action.longknives_used": "Seruan Terakhir kepada Fraksi telah digunakan.",
	"action.new_interactions": "Interaksi baru dengan $NAME$ di bawah ini.",
	"action.next_turn": "AKHIRI AGENDA",
	"action.routine_photo": "TINDAKAN RUTIN",
	"action.routine_title": "Tindakan Eksekutif Rutin",
	"action.select_portrait": "Pilih potret utusan di bawah ini untuk memulai negosiasi.",
	"action.session_available": "Kita dapat menyampaikan satu Seruan Terakhir kepada Fraksi.",
	"action.session_used": "Kita telah menyampaikan Seruan Terakhir kepada Fraksi.",
	"action.title_default": "Agenda Kepresidenan",
	"action.title_session": "Sidang Umum MPR",
	"app.title": "Twilight of the Banyan Tree",
	"authority.doubt.line": "Bisik-bisik keraguan mulai memperlambat kerja birokrasi.",
	"authority.eroding.line": "Krisis yang kian menumpuk secara nyata menggerus wibawa Istana.",
	"authority.intact.line": "Wewenang kepresidenan di seluruh kementerian tetap utuh.",
	"authority.paralysis.line": "Pemerintahan terjebak dalam kelumpuhan institusional yang mendalam.",
	"bio.habibie.image_alt": "B.J. Habibie",
	"bio.habibie.p1": "Bacharuddin Jusuf Habibie lahir pada 25 Juni 1936 di kota pelabuhan Parepare, Sulawesi Selatan, sebagai anak keempat dari delapan bersaudara pasangan Alwi Abdul Jalil Habibie, seorang pejabat pertanian berdarah Gorontalo, dan R.A. Tuti Marini Puspowardojo, seorang bangsawan Jawa asal Yogyakarta. Pada 3 September 1950, ketika Habibie—yang akrab disapa \"Rudy\" oleh keluarganya—baru berusia empat belas tahun, sang ayah wafat akibat serangan jantung mendadak saat sedang menunaikan salat Isya. Bertekad agar anak-anaknya mengenyam pendidikan modern, sang ibu yang kini menjanda memboyong keluarganya ke Bandung dan menjual harta benda keluarga demi membiayai pendidikannya. Setelah satu tahun menempuh kuliah teknik mesin di Institut Teknologi Bandung (ITB) pada tahun 1954, Habibie berangkat ke Jerman Barat pada tahun 1955 untuk mempelajari teknik penerbangan di Rheinisch-Westfälische Technische Hochschule (RWTH) di Aachen, yang awalnya dibiayai langsung oleh ibunya sebelum prestasi akademiknya membuahkan beasiswa negara dari Jakarta.",
	"bio.habibie.p2": "Bertahan melewati musim dingin Eropa yang membekukan dan serangan tuberkulosis tulang yang nyaris merenggut nyawanya, Habibie meraih gelar [i]Diplom-Ingenieur[/i] pada tahun 1960, menikahi teman semasa SMA-nya Hasri Ainun Besari pada tahun 1962, dan merampungkan gelar [i]Doktor-Ingenieur[/i] pada tahun 1965 dengan predikat tertinggi, [i]summa cum laude[/i], lewat disertasi mengenai tegangan termoelastis pada penerbangan supersonik. Bergabung dengan Hamburger Flugzeugbau—yang kemudian melebur ke dalam raksasa dirgantara Jerman Barat Messerschmitt-Bölkow-Blohm (MBB) pada tahun 1969—kariernya menanjak hingga menjabat sebagai Wakil Presiden Bidang Teknologi Terapan, posisi tertinggi yang pernah diduduki oleh warga negara asing di industri penerbangan Jerman. Di sana ia merumuskan metode matematis untuk menghitung kelelahan logam dan perambatan retak hingga ke tingkat kisi atom pada sayap pesawat Airbus A300 serta pesawat angkut NATO, yang membuatnya dijuluki 'Mr. Crack' sepanjang hidupnya. Pada Desember 1973, Presiden Soeharto mengutus Direktur Utama Pertamina Ibnu Sutowo ke Düsseldorf untuk memanggil pulang Habibie guna memimpin modernisasi industri Indonesia. Kembali ke Jakarta pada tahun 1974, Habibie mendirikan Badan Pengkajian dan Penerapan Teknologi (BPPT) dan, pada tahun 1976, mendirikan perusahaan manufaktur pesawat terbang negara PT Industri Pesawat Terbang Nurtanio—yang kemudian berganti nama menjadi Nusantara (IPTN)—di Bandung.",
	"bio.habibie.p3": "Dari Maret 1978 hingga Maret 1998, Habibie menjabat di lima kabinet berturut-turut sebagai Menteri Negara Riset dan Teknologi (Menristek) sekaligus Kepala Badan Pengelola Industri Strategis (BPIS), membawahi galangan kapal, pabrik senjata, industri baja, dan kawasan industri Batam. Dianakemaskan oleh Soeharto layaknya putra angkatnya sendiri, Habibie berulang kali berselisih dengan para teknokrat ekonomi lulusan Berkeley terkait subsidi negara untuk ambisi puncaknya: pesawat turboprop [i]fly-by-wire[/i] karya anak bangsa N-250 [i]Gatotkaca[/i], yang penerbangan perdananya pada 10 Agustus 1995 menjadi mahakarya perayaan ulang tahun kemerdekaan Republik yang ke-50. Pada Desember 1990, dengan restu Soeharto, ia menjadi Ketua Umum pertama Ikatan Cendekiawan Muslim se-Indonesia (ICMI), mengubah jaringan cendekiawan dan birokrat Muslim modernis menjadi kekuatan penyeimbang yang tangguh terhadap jajaran petinggi militer nasionalis-sekuler di dalam tubuh Golkar. Ketika Soeharto menunjuknya sebagai Wakil Presiden ketujuh pada Maret 1998 di puncak Krisis Finansial Asia, pasar valuta asing bereaksi negatif atas reputasinya yang gemar membiayai proyek-proyek industri raksasa. Sepuluh minggu kemudian—setelah Soeharto sempat meragukannya di malam menjelang pengunduran dirinya—Habibie dilantik sebagai Presiden di Istana Merdeka pada pagi hari tanggal 21 Mei 1998, mengemban tugas membongkar dari dalam bangunan otoriter yang selama ini menaungi seluruh kariernya, menstabilkan perekonomian yang hancur lebur, serta memperjuangkan legitimasi di hadapan parlemen yang memandangnya tak lebih dari sekadar presiden transisi yang kebetulan naik takhta.",
	"bio.habibie.title": "B.J. Habibie",
	"category.civil_society": "Masyarakat Sipil",
	"category.economy": "Ekonomi",
	"category.politics": "Politik",
	"category.regional_affairs": "Urusan Daerah",
	"category.security": "Keamanan",
	"changelog.0.date": "2 November 2026",
	"changelog.0.note.0": "Pembaruan ini menambahkan interaksi Golkar yang masih eksperimental, antarmuka seluler yang dirombak, serta memperbaiki daftar panjang bug permainan, pencapaian yang tidak sesuai, dan sisa-sisa kode lama.",
	"changelog.0.note.1": "[b]KONTEN BARU[/b]\n\n• Layar fraksi Golkar kini menampilkan tiga huruf besar, [b]A[/b] (ABRI), [b]B[/b] (Birokrasi), dan [b]G[/b] (Golkar). Ketuk sebuah huruf untuk membaca penjelasannya dan dekret apa yang mematahkannya.",
	"changelog.0.note.2": "[b]KAMPANYE BARU:[/b]\n\n• Setelah memilih tingkat kesulitan, layar [i]Situasi Saat Ini[/i] sekarang menanyakan apakah Anda ingin membaca laporan lengkap ([i]\"Saya ingin tahu apa yang terjadi!!\"[/i]) atau langsung memulai ([i]\"Langsung main saja!\"[/i]).",
	"changelog.0.note.3": "[b]SELULER[/b]\n\n• Berbagai macam perbaikan dan peningkatan..",
	"changelog.0.note.4": "[b]PERBAIKAN GAMEPLAY[/b]\n\n• [b]BANDING AKHIR:[/b] Kini terbuka pada Pidato Pertanggungjawaban dan Malam Pisau Panjang, tidak lagi terikat pada giliran terakhir yang tidak punya fase aksi. [i]Halo, Halo Senayan[/i] sekarang membutuhkan dua Banding Akhir, jumlah terbanyak yang bisa dipakai dalam satu permainan.\n• [b]KEMENANGAN:[/b] Memenangkan pemungutan suara kini selalu membutuhkan [b]351 dari 700[/b] suara, meskipun ada fraksi yang dilarang.\n• [b]MILITER:[/b] Efek yang mencantumkan [i]mil[/i] sekaligus [i]abri[/i] tidak lagi diterapkan keduanya (efeknya tidak lagi berlaku dua kali lipat).\n• [b]DEKRET:[/b] Dekret yang saling meniadakan kini saling memblokir dari kedua arah.\n• [b]PENCAPAIAN:[/b] [i]Suara Rakyat[/i] kini terbuka pada tingkat popularitas \"Tolerated\" sesuai namanya.",
	"changelog.0.note.5": "[b]PERBAIKAN:[/b] Memperbaiki pemutar musik yang tidak mengulang saat hanya ada satu lagu dalam sebuah genre, dan nama gaya yang salah ketik pada kertas hasil pemungutan suara. Kode lama dihapus.",
	"changelog.0.title": "Beta 0.2.1 Hotfix",
	"changelog.1.date": "30 Oktober 2026",
	"changelog.1.note.0": "Versi ini menghadirkan lokalisasi Bahasa Indonesia beserta perombakan besar pada tingkat kesulitan, mekanika oposisi, keseimbangan permainan, antarmuka (UI), pemutar musik, dan pembersihan kode.",
	"changelog.1.note.1": "[b]KONTEN BARU[/b]\n\n• [b]SITUASI SIAGA SATU (SSS):[/b] Menangkan tingkat kesulitan Historis untuk membuka papan krisis kustom berisi 24 kartu situasi. Menangkan Sidang Umum dengan seluruh kartu situasi pada Tingkat III untuk membuka pencapaian [i]Hak Pamer[/i].\n• [b]OPOSISI PDI-P:[/b] Menambahkan bar Mobilisasi Massa di layar fraksi PDI-P.\n• [b]OPOSISI MILITER:[/b] Menambahkan bar Kesabaran dan Kemarahan di layar fraksi Militer (TNI/ABRI).\n• [b]PENCAPAIAN (ACHIEVEMENTS):[/b] Diperluas menjadi 66 pencapaian (31 baru) yang mencakup jalur reformis, otoriter, statistik, dan manuver fraksi, serta memperbaiki pemicu pembuka pencapaian [i]Hak Pamer[/i].\n• [b]PEMUTAR MUSIK:[/b] Menambahkan filter genre (Lagu Kebangsaan, Kritik Sosial, Pop, Mancanegara) serta bilah durasi dan pengatur volume langsung di panel kiri.",
	"changelog.1.note.2": "[b]TINGKAT KESULITAN[/b]\nDiperbarui dan dirombak ulang. Selain memodifikasi [color=__STAT_PC__]Modal Politik (PC)[/color] awal, [color=__STAT_CENDANA__]Pengaruh Cendana[/color], [color=__CLR_DARK_RED__]Penalti Stabilitas[/color], biaya tindakan [color=__STAT_PC__]PC[/color], dan kemarahan militer, kini setiap tingkat kesulitan juga mengatur tingkat pembelotan delegasi, gejolak ruang sidang, hasil peristiwa, serta daya tawar (leverage) fraksi:\n\n• [b]Mudah (Easy):[/b] 75 PC awal, +15 pada statistik awal, Cendana mulai di 40. Biaya dekrit dan kesepakatan fraksi 10% lebih murah, dampak buruk peristiwa 25% lebih ringan, dan kesepakatan fraksi memberi hasil 15% lebih besar.\n• [b]Sedang (Medium):[/b] 50 PC awal, +5 pada statistik awal, Cendana di 60, +1 PC/giliran. Hasil positif peristiwa 8% lebih kuat dan kesepakatan fraksi memberi hasil 15% lebih besar.\n• [b]Tinggi (High):[/b] 35 PC awal, tanpa bonus statistik, Cendana di 75. Biaya tindakan sedikit lebih mahal, peristiwa buruk menghantam 5% lebih keras, dan pengaruh Cendana perlahan tumbuh kembali.\n• [b]Historis (Historical):[/b] 20 PC awal, Cendana di 95, biaya tindakan +15% lebih mahal (+2 PC pada setiap kesepakatan fraksi). Peristiwa buruk menghantam 10% lebih keras, peristiwa baik 5% lebih lemah, utang budi (favor) dibatasi maksimal 2 per fraksi, dan waktu tunggu (cooldown) semua tindakan 1 giliran lebih lama.",
	"changelog.1.note.3": "[b]MEKANIKA PERMAINAN (GAMEPLAY)[/b]\n\n• [b]STATISTIK:[/b] Dukungan fraksi di atas batas awal kini meluruh perlahan setiap giliran kecuali terus dirawat, statistik yang sangat tinggi perlahan turun mendekati titik netral (sementara statistik rendah terdorong naik pada tingkat Mudah/Sedang), dan Cendana tumbuh kembali menuju kekuatan awalnya.\n• [b]SIDANG UMUM & PEMILIHAN:[/b] Menambahkan ayunan suasana ruang sidang, kejutan delegasi liar (wildcard), suara lintas fraksi, serta pembelotan pemungutan suara tertutup yang disesuaikan dengan tingkat kesulitan.\n• [b]DAYA TAWAR (LEVERAGE):[/b] Daya tawar terhadap fraksi kini mengubah pengali biaya dan perolehan secara bertahap, bukan lagi melompat kaku per tingkatan.\n• [b]DEKRIT:[/b] Batas minimum statistik dan loyalitas yang dijamin oleh dekrit kini naik bertahap setiap giliran, bukan langsung terkunci seketika.\n• [b]TINDAKAN RUTIN:[/b] Mengulang Tindakan Rutin atau Kesepakatan Fraksi yang sama terus-menerus kini menghasilkan PC yang makin kecil dan dampak yang makin lemah.\n• [b]UTANG BUDI (FAVOR):[/b] Jumlah utang budi yang dapat disimpan per fraksi kini dibatasi menurut tingkat kesulitan.",
	"changelog.1.note.4": "[b]PENYEIMBANGAN ULANG (REBALANCE)[/b]\n\n• [b]TINDAKAN & PERISTIWA:[/b] Merombak ulang Dekrit, Tindakan Rutin, Kesepakatan Fraksi, dan Peristiwa agar selaras dengan kurva kesulitan baru, memangkas opsi yang terlalu kuat, dan memperhalus tingkat kesulitan Sedang.\n• [b]OPOSISI:[/b] Menyeimbangkan dampak terhadap Militer dan PDI-P di seluruh peristiwa dan tindakan; dekrit ekstrem kini memberikan guncangan langsung pada kesabaran Militer, sementara loyalitas Militer yang tinggi memperlambat dan mengikis kemarahan mereka.\n• [b]MODAL POLITIK (PC):[/b] Membatasi pendapatan PC pasif maksimal 10 PC, mengubah penalti ketidakstabilan menjadi potongan proporsional terhadap perolehan PC tindakan rutin, serta membatasi potongan gabungan Militer/PDI-P agar tidak melebihi batas.",
	"changelog.1.note.5": "[b]ANTARMUKA (UI) & PEMBERSIHAN[/b]\n\n• [b]VISUAL:[/b] Menambahkan skema warna baru (Merah Putih, Rainbow, Rainbow Swirl, Twilight, Kopi, Solarized), efek kilau kaca pada gambar, memperbesar foto \"In Memoriam\", serta mengubah warna Poros Tengah menjadi hijau Islam setelah terbentuk.\n• [b]TEKS & PERINGATAN:[/b] Memadatkan teks peristiwa, fraksi, dan dekrit menjadi maksimal dua paragraf, meratakan kanan-kiri (justify) deskripsi kesepakatan fraksi, menyeragamkan seluruh nama statistik, serta memberi kode warna pada teks meteran dan pemberitahuan interaksi baru.\n• [b]DI BALIK LAYAR:[/b] Merapikan format Pustaka (Library), menyatukan teks sikap fraksi dan tingkatan statistik untuk lokalisasi, menghapus kode layar muat/tooltip lama, serta memperbaiki berbagai bug kecil dan salah ketik.",
	"changelog.1.note.6": "[b]DIHAPUS[/b]\n\n• Menghapus Pakta Cilangkap, gambar ikon pencapaian, serta baris status mobilisasi jalanan dan tooltip dari layar agenda kepresidenan.",
	"changelog.1.title": "Beta 0.2 \"Rekayasa Politik\"",
	"changelog.2.date": "21 Oktober 2026",
	"changelog.2.note.0": "Militer kini berkoordinasi dengan fraksi lain untuk mendongkel Anda jika Anda membuat mereka murka, serta membiarkan kerusuhan dan pengambinghitaman minoritas terjadi.",
	"changelog.2.note.1": "PDI-P dan Poros Tengah enggan berada di dalam koalisi yang sama.",
	"changelog.2.note.10": "Penyeimbangan kecil pada angka permainan.",
	"changelog.2.note.11": "Merapikan menu Pengaturan dengan mengubah pilihan skema warna menjadi menu dropdown.",
	"changelog.2.note.2": "Membubarkan kursi fraksi memengaruhi kredibilitas Anda di mata para delegasi, dan sebagian kursi yang dialihkan dapat melakukan walkout saat pemungutan suara.",
	"changelog.2.note.3": "Merombak AI oposisi (fondasi awal untuk pembaruan berikutnya).\n\n• [color=__CLR_BRIGHT_RED__]Belum ada jendela pop-up khusus, tetapi Megawati, Amien Rais, dan Wiranto kini aktif menyabotase pemerintahan Anda di balik layar.[/color]",
	"changelog.2.note.4": "Menambahkan struktur awal untuk perombakan sistem lokalisasi.",
	"changelog.2.note.5": "Menulis ulang informasi fraksi agar lebih ringkas dan padat.",
	"changelog.2.note.6": "Mengganti potret loyalis Golkar menjadi A.A. Baramuli.",
	"changelog.2.note.7": "Mengubah nama faksi loyalis Golkar dari Irama Tersedak menjadi Iramasuka Nusantara (Irian Jaya, Maluku, Sumatra, Sulawesi, Kalimantan, dan Nusa Tenggara).",
	"changelog.2.note.8": "Memperbaiki tampilan antarmuka perhitungan suara Sidang Umum MPR.",
	"changelog.2.note.9": "Unduhan hasil akhir (State of the Republic) kini menampilkan daftar dekrit yang telah disahkan.",
	"changelog.2.title": "Beta 0.1.3 Hotfix",
	"changelog.3.date": "20 Oktober 2026",
	"changelog.3.note.0": "Kesabaran Jenderal Wiranto tidak lagi tak terbatas: jika Cilangkap terus diabaikan, pasukan akan memilih diam di barak saat jalanan ibu kota terbakar.",
	"changelog.3.note.1": "Amien Rais dan Gus Dur kembali ingat bahwa mereka memegang 163 kursi dan bukan bawahan Anda.",
	"changelog.3.note.2": "Akbar Tandjung mulai kebal terhadap gertakan pemerasan mingguan Anda.",
	"changelog.3.note.3": "Taufik Kiemas sudah bosan dijamu kopi gratis terus-menerus.",
	"changelog.3.note.4": "Meningkatkan tingkat pembelotan pada pemungutan suara tertutup.",
	"changelog.3.title": "Beta 0.1.2 Hotfix",
	"changelog.4.date": "19 Oktober 2026",
	"changelog.4.note.0": "[b]Amien Rais dan Gus Dur tidak lagi menyerahkan kursi kepresidenan secara cuma-cuma:[/b] Utang budi koalisi kini dipangkas saat peleburan Poros Tengah, dan pencairan utang budi pada lobi terakhir memiliki batas hasil menurun (diminishing returns).",
	"changelog.4.note.1": "[b]Celah cetak PC tanpa batas telah ditambal:[/b] Memangkas perolehan dasar Modal Politik (PC) pada tindakan rutin agar pemain tidak bisa mencetak 300+ PC seperti mesin ATM.",
	"changelog.4.note.2": "[b]PDI-P dapat melumpuhkan ibu kota jika terus dimusuhi:[/b] Membiarkan kubu Megawati jatuh ke dalam permusuhan mendalam kini memicu demonstrasi besar-besaran kaos merah yang menguras Stabilitas Nasional dan membuat delegasi daerah panik.\n\n• Menambahkan indikator 'Mobilisasi Massa' di layar PDI-P untuk memantau seberapa dekat massa Satgas dengan kerusuhan terbuka.",
	"changelog.4.note.3": "[b]Keluarga Cendana tidak lagi tinggal diam:[/b] Menghantam pengaruh keluarga Soeharto terlalu drastis dalam satu giliran kini memicu pelarian modal dan sabotase jalanan.",
	"changelog.4.note.4": "Menyatukan kembali Golkar di bawah DPP Slipi kini menetapkan batas loyalitas minimum yang wajar, bukan langsung menjadikannya 100% setia selamanya.",
	"changelog.4.title": "Beta 0.1.1 Hotfix",
	"changelog.5.date": "19 Oktober 2026",
	"changelog.5.note.0": "Masih terdapat beberapa bug dan fitur yang belum lengkap, namun permainan sudah dapat dimainkan sepenuhnya dengan seluruh mekanika inti.\n[color=__CLR_BRIGHT_RED__]Ini adalah rilis beta, silakan laporkan bug apa pun yang Anda temukan!\nCatatan: \n\n• Beberapa gambar masih berupa placeholder\n• Beberapa fitur masih dalam tahap pengujian\n• Penyesuaian tampilan di sejumlah ukuran layar\n[/color]",
	"changelog.5.title": "Rilis Beta \"Pidato Pertanggungjawaban\"",
