	"dash.banned_mood": "Dissolved",
	"dash.delegates": "$COUNT$ Delegates",
	"dash.dissolved_stamp": "DISSOLVED",
	"dash.dissolved_tooltip": "This caucus has been dissolved by decree and stripped of its seats in Senayan.",
	"dash.faction_view": "Caucus Leaders",
