[gd_resource type="Resource" script_class="LocalePackData" load_steps=2 format=3]

[ext_resource type="Script" path="res://godot/scripts/resources/locale_pack_data.gd" id="1_locpack"]

[resource]
script = ExtResource("1_locpack")
locale_code = "en"
locale_name = "English"
strings = {
	"ach.always_more_austerity.desc": "Please the [color=__CLR_INFO_BLUE__][b]IMF[/b][/color] by eliminating fuel and power subsidies, dismantling BULOG, and liquidating insolvent banks while reaching maximum International Standing with Economic Health and Popularity in ruins (Medium+).",
	"ach.always_more_austerity.title": "President Habibie's response is, as always, more austerity.",
	"ach.aman_terkendali.desc": "Reach the top National Stability tier ('$tier.stab.uneasy_calm$') on Medium difficulty or above. Everything is secure and under control, as the saying went. Please do not look under the carpet.",
	"ach.aman_terkendali.title": "Aman Terkendali™",
	"ach.asas_tunggal_restored.desc": "Re-impose the 1985 Asas Tunggal law under emergency rule and dissolve the religious party blocs in the MPR.",
	"ach.asas_tunggal_restored.title": "Pancasila Forever!",
	"ach.back_to_the_barracks.desc": "Abolish ABRI's 38 unelected MPR seats and dismantle the Kodam territorial command structure in a single campaign.",
	"ach.back_to_the_barracks.title": "Back to the Barracks",
	"ach.baligate_clean.desc": "Blow the lid off Bank Bali. Freeze EGP's accounts, grant PwC unrestricted access, hand the unredacted files to PDI-P's Pansus, and declassify the full audit.",
	"ach.baligate_clean.title": "546 Billion Reasons Why",
	"ach.beringin_tumbang.desc": "Disqualify Akbar Tandjung's old-guard Golkar caucus over the Bank Bali election-fraud audit.",
	"ach.beringin_tumbang.title": "Pruning the Banyan Tree",
	"ach.bhinneka_coalition.desc": "Complete the MPR General Session with PDI-P, Poros Tengah, Golkar (DPP Slipi) and TNI all at 60 or higher loyalty.",
	"ach.bhinneka_coalition.title": "Bhinneka Tunggal Ika",
	"ach.bruning_impressed.desc": "Survive the MPR General Session having enacted all three IMF mandates, reached maximum International Standing, and tanked Economic Health and Popularity. (Any Difficulty)",
	"ach.bruning_impressed.title": "Brüning Impressed.",
	"ach.camdessus_arms.desc": "Resurrect Steve Hanke's Currency Board Scheme, defy the IMF's Bank Bali ultimatum, and still finish the game with Economic Health at '$tier.econ.stagnant$' or better.",
	"ach.camdessus_arms.title": "Who's Folding Their Arms Now, Michel?",
	"ach.cendana_cashback.desc": "Seize the Cendana toll roads, audit the Kodam foundations and convene the Suharto asset seizure tribunal. Receipts, please.",
	"ach.cendana_cashback.title": "Cendana Cashback",
	"ach.cendana_zero.desc": "Completely eradicate Cendana Influence on Medium difficulty or above.",
	"ach.cendana_zero.title": "Cendana Delenda Est",
	"ach.cleared_for_takeoff.desc": "Protect BPPT/IPTN research funding AND champion the N-250 Gatotkaca turboprop budget line, then win the MPR General Session.",
	"ach.cleared_for_takeoff.title": "Cleared for Takeoff, Gatotkaca",
	"ach.complete_run.desc": "Complete a full run of the MPR General Session, regardless of the outcome.",
	"ach.complete_run.title": "The 512th Day",
	"ach.deja_vu_322.desc": "Lose the MPR General Session with almost the exact tally of Habibie's real-life 322–355 rejection on the night of October 19–20, 1999.",
	"ach.deja_vu_322.title": "355 to 322: Historical Déjà Vu",
	"ach.dipecat_dengan_hormat.desc": "Lose the MPR General Session while overall Government Stability is $gov.stable$ or $gov.secure$.",
	"ach.dipecat_dengan_hormat.title": "Honorably Discharged",
	"ach.dwifungsi_kaput.desc": "Separate POLRI from ABRI, expand Komnas HAM's authority over the military, and still win the MPR vote.",
	"ach.dwifungsi_kaput.title": "A Farewell to Dwifungsi",
	"ach.empire_strikes_beringin.desc": "Pass the Kamra militia bill, reinstate SIUPP press censorship, purge Utusan Golongan and mobilize the Pam Swakarsa. A long time ago, in a regime not so far away...",
	"ach.empire_strikes_beringin.title": "The Empire Strikes Beringin",
	"ach.enak_jamanku.desc": "Win the MPR General Session with Cendana Influence nearly $tier.cendana.untouchable$ and Reformasi Credibility reduced to '$tier.ref.authoritarian$' or '$tier.ref.new_order_crony$'.",
	"ach.enak_jamanku.title": "\"Piye Kabare? Enak Jamanku Toh?\"",
	"ach.et_tu_akbar.desc": "Lose the MPR General Session despite holding '$mood.golkar_habibie.ride_or_die$' loyalty with your Golkar Loyalists because Akbar Tandjung's Golkar faction abandoned you.",
	"ach.et_tu_akbar.title": "Et Tu, Akbar?",
	"ach.finis_dwifungsi.desc": "Create a civilian defense ministry, separate POLRI from ABRI, dismantle the Kodam command structure and abolish ABRI's MPR seats. Cilangkap has seen your message and is composing a reply.",
	"ach.finis_dwifungsi.title": "End Dwifunsi button",
	"ach.fumes_in_the_tank.desc": "Enter the MPR General Session with zero Political Capital remaining and win the presidency anyway.",
	"ach.fumes_in_the_tank.title": "Gliding on Empty",
	"ach.gus_dur_twist.desc": "Help Amien Rais become MPR Speaker, cultivate a '$mood.poros_tengah_merged.leaning_toward_habibie$' stance (or better) with the Central Axis, and still lose the Accountability Vote.",
	"ach.gus_dur_twist.title": "Bah! Wait, That's Gus Dur's Music!",
	"ach.habibi_ya_habibi.desc": "Win the MPR General Session with overwhelming support across the Central Axis, Utusan Golongan, and the Minor Parties.",
	"ach.habibi_ya_habibi.title": "Habibi, Ya Habibi!",
	"ach.halo_andi.desc": "Uphold the October 11 SP3 order terminating the Suharto corruption investigation while Cendana Influence remains deeply $tier.cendana.entrenched$ or $tier.cendana.untouchable$.",
	"ach.halo_andi.title": "\"Halo, Andi? Apa Kabar?\"",
	"ach.halo_halo_senayan.desc": "Work the telephones every night of the finale: use a Final Appeal on both action nights of the finale: the Accountability Speech and the Night of the Long Knives.",
	"ach.halo_halo_senayan.title": "Halo, Halo Senayan",
	"ach.kaos_merah.desc": "Win the MPR General Session even though PDI-P's Street Mobilization hit 100% and the bloc voted to reject to the last delegate.",
	"ach.kaos_merah.title": "Red Shirts Aren't Enough",
	"ach.khatam.desc": "Win the MPR General Session on every standard difficulty: Easy, Medium, High and Historical. Like finishing the whole book cover to cover.",
	"ach.khatam.title": "Khatam!",
	"ach.kudatuli_redux.desc": "Outlaw Megawati's PDI-P by emergency decree and redistribute its 153 seats across the Assembly.",
	"ach.kudatuli_redux.title": "July 27 All Over Again",
	"ach.lose_decisive.desc": "Suffer a decisive defeat in the MPR General Session.",
	"ach.lose_decisive.title": "The End of an Era",
	"ach.lose_narrow.desc": "Lose the presidency by a razor-thin margin.",
	"ach.lose_narrow.title": "A Valiant Effort",
	"ach.lose_overwhelming.desc": "Lose the MPR General Session in an overwhelming landslide against you (Under 200 votes).",
	"ach.lose_overwhelming.title": "Total Repudiation",
	"ach.mr_crack.desc": "Let overall Government Stability fall into UNSTABLE or COLLAPSING, then engineer a structural recovery and win the MPR General Session.",
	"ach.mr_crack.title": "Mr. Crack Never Cracks",
	"ach.ngopi_dulu.desc": "Win the MPR General Session with the generals neither angry nor alienated. Have some coffee first, General.",
	"ach.ngopi_dulu.title": "Coffee First, General?",
	"ach.nkri_terms.desc": "Enact regional autonomy, the Aceh special status law and the Maluku–Irian Jaya division. The unitary state is non-negotiable, except for the parts that were negotiated.",
	"ach.nkri_terms.title": "Non-Negotiable Unity (Terms and Conditions Apply)",
	"ach.odd_bedfellows.desc": "Win the MPR General Session while PDI-P and Poros Tengah, who have been coordinating against you, both hold 70 or higher loyalty.",
	"ach.odd_bedfellows.title": "Odd Bedfellows",
	"ach.orba_jilid_dua.desc": "Enact both 'Supersemar II' and the Jalan Cendana Restoration Pact, and survive the MPR General Session.",
	"ach.orba_jilid_dua.title": "Orde Baru Jilid II",
	"ach.pdip_max.desc": "Win over Megawati's PDI-P completely on Medium difficulty or above.",
	"ach.pdip_max.title": "The Unholy Compromise",
	"ach.persona_non_grata.desc": "Win the MPR General Session with International Standing in '$tier.intl.pariah_state$'.",
	"ach.persona_non_grata.title": "Persona Non Grata, Mr. President",
	"ach.pop_max.desc": "Reach the peak of Popularity ('$tier.pop.tolerated$') on Medium difficulty or above.",
	"ach.pop_max.title": "Voice of the People",
	"ach.presiden_rebahan.desc": "Win the MPR General Session without enacting a single Extraordinary Decree. Governing is tiring, sometimes, the best policy is to lie down.",
	"ach.presiden_rebahan.title": "The Couch Potato President",
	"ach.rainbow_coalition.desc": "Proclaim a government of national unity with PDI-P, Golkar, Central Axis, and ABRI.",
	"ach.rainbow_coalition.title": "The Rainbow Coalition",
	"ach.sedia_payung.desc": "Reach the MPR General Session with Political Capital at the maximum (100).",
	"ach.sedia_payung.title": "Umbrella Before the Rain",
	"ach.sinetron_villain.desc": "Win the MPR General Session with Popularity in '$tier.pop.universally_hated$'.",
	"ach.sinetron_villain.title": "The Soap Opera Villain Wins",
	"ach.singa_reformasi.desc": "Win the MPR General Session with Reformasi Credibility at its highest tier and Cendana Influence reduced to $tier.cendana.weakened$ or $tier.cendana.dormant$.",
	"ach.singa_reformasi.title": "LION of reformasi",
	"ach.siupp_is_back.desc": "Reinstate SIUPP press licensing.",
	"ach.siupp_is_back.title": "SIUPP Is Back, Baby",
	"ach.thankless_burden.desc": "Honor the August 30 East Timor referendum at every turn, invite UN peacekeepers on September 12, and still win the MPR General Session.",
	"ach.thankless_burden.title": "Nobel Laureate in Spirit",
	"ach.the_center_holds.desc": "Win the MPR General Session with a majority of delegates backing you in both Golkar wings, Utusan Daerah, Utusan Golongan, the Minor Parties and TNI.",
	"ach.the_center_holds.title": "The Center Holds",
	"ach.those_who_stayed_silent.desc": "Lose the MPR General Session with 330 to 350 votes in favor, where blank ballots and absent delegates, not the 'no' votes, kept you from the 351 you needed.",
	"ach.those_who_stayed_silent.title": "Those Who Stayed Silent",
	"ach.tolak_lupa.desc": "Commemorate Trisakti and Semanggi, reconcile with Chinatown, found the Women's Commission, review the SBKRI rules, declassify the 1965 files and repeal the Chinese cultural ban.",
	"ach.tolak_lupa.title": "Menolak Rupa",
	"ach.total_reformasi.desc": "Enact all seven pillars of reform. The anti-corruption law, civil service neutrality, direct presidential elections, the Suharto asset tribunal, the political prisoner release, Komnas HAM's new powers and broadcast liberalization.",
	"ach.total_reformasi.title": "Reformasi Total, Bung!",
	"ach.ucn_6am.desc": "Defend your Accountability Speech in Severe State Situations (SSS) with every situation card set to Level III.",
	"ach.ucn_6am.title": "Bragging Rights",
	"ach.unify_golkar.desc": "Reconcile the two wings of Golkar.",
	"ach.unify_golkar.title": "Unify Golkar",
	"ach.utang_budi.desc": "Hold at least one banked Favor with six different factions at the same time.",
	"ach.utang_budi.title": "A Debt of Honor, Carried to the Grave",
	"ach.utang_nanti_dulu.desc": "Win the MPR General Session with Economic Health in '$tier.econ.bankruptcy$'.",
	"ach.utang_nanti_dulu.title": "Debts can wait",
	"ach.win_any.desc": "Win the MPR General Session and retain the presidency on any difficulty.",
	"ach.win_any.title": "The Caretaker No More",
	"ach.win_comfortable.desc": "Win the MPR General Session with a comfortable majority (380+ votes).",
	"ach.win_comfortable.title": "Comfortable Majority",
	"ach.win_historical.desc": "Defy history and win the MPR General Session on Historical difficulty.",
	"ach.win_historical.title": "A Full Term Secured",
	"ach.win_narrow.desc": "Survive the MPR General Session in a narrow upset.",
	"ach.win_narrow.title": "By the Skin of Your Teeth",
	"ach.win_overwhelming.desc": "Win the MPR General Session with an overwhelming landslide (450+ votes).",
	"ach.win_overwhelming.title": "A New Mandate",
	"achievement.unlocked_title": "Achievement Unlocked!",
	"achievements.intro": "Review your achievements below.",
	"action.decrees_photo": "EXTRAORDINARY DECREES",
	"action.decrees_title": "Extraordinary Decrees",
	"action.exec_available": "We can enact an executive action or decree.",
	"action.exec_used": "We cannot enact another executive action or decree this turn.",
	"action.faction_available": "We may engage with as many factions as we wish this turn, but each engagement adds $STEP$ PC to the cost of the next one.",
	"action.faction_used": "We have held $COUNT$ faction engagement(s) this turn. The next one carries a surcharge of $SURCHARGE$ PC.",
	"action.longknives_available": "We may deliver one Final Faction Appeal.",
	"action.longknives_used": "Final Faction Appeal used.",
	"action.new_interactions": "New interaction with $NAME$ below.",
	"action.next_turn": "CONCLUDE AGENDA",
	"action.routine_photo": "ROUTINE ACTIONS",
	"action.routine_title": "Routine Executive Actions",
	"action.select_portrait": "Select a delegate portrait below to initiate negotiations.",
	"action.session_available": "We may deliver one Final Faction Appeal.",
	"action.session_used": "We have already delivered a Final Faction Appeal.",
	"action.title_default": "Presidential Agenda",
	"action.title_session": "MPR General Session",
	"app.title": "Twilight of the Banyan Tree",
	"authority.doubt.line": "Whispers of doubt are beginning to slow the bureaucracy.",
	"authority.eroding.line": "Mounting crises are visibly eroding the Palace's authority.",
	"authority.intact.line": "Presidential authority across the ministries remains intact.",
	"authority.paralysis.line": "The administration is mired in deep institutional paralysis.",
	"bio.habibie.image_alt": "B.J. Habibie",
	"bio.habibie.p1": "Bacharuddin Jusuf Habibie was born on June 25, 1936, in the port town of Parepare, South Sulawesi, the fourth of eight children born to Alwi Abdul Jalil Habibie, an agricultural official of Gorontalese descent, and R.A. Tuti Marini Puspowardojo, a Javanese noblewoman from Yogyakarta. On September 3, 1950, when Habibie—\"Rudy\" to his family—was just fourteen, his father suffered a fatal heart attack during evening prayers. Determined that her children receive a modern education, his widowed mother moved the family to Bandung and sold off family property to fund his studies. After a year studying mechanical engineering at the Bandung Institute of Technology (ITB) in 1954, Habibie traveled to West Germany in 1955 to study aerospace engineering at the Rheinisch-Westfälische Technische Hochschule (RWTH) in Aachen, initially financed directly by his mother before his academic record earned him a state scholarship from Jakarta.",
	"bio.habibie.p2": "Surviving harsh European winters and a bout of tuberculosis that nearly killed him, Habibie earned his [i]Diplom-Ingenieur[/i] in 1960, married his high-school contemporary Hasri Ainun Besari in 1962, and completed his [i]Doktor-Ingenieur[/i] in 1965 with the highest distinction, [i]summa cum laude[/i], defending a dissertation on thermoelastic stress in supersonic flight. Joining Hamburger Flugzeugbau—which merged into the West German aerospace giant Messerschmitt-Bölkow-Blohm (MBB) in 1969—he rose to become Vice President for Applied Technology, the highest post held by a foreign national in the German aviation industry. There he formulated mathematical methods for calculating metal fatigue and crack propagation down to the atomic lattice on the wings of the Airbus A300 and NATO transport aircraft, earning the lifelong moniker 'Mr. Crack.' In December 1973, President Suharto dispatched Pertamina chief Ibnu Sutowo to Dusseldorf to summon Habibie home to spearhead Indonesia's industrial modernization. Returning to Jakarta in 1974, Habibie established the Agency for the Assessment and Application of Technology (BPPT) and, in 1976, founded the state aircraft manufacturer PT Industri Pesawat Terbang Nurtanio—later Nusantara (IPTN)—in Bandung.",
	"bio.habibie.p3": "From March 1978 to March 1998, Habibie served across five consecutive cabinets as State Minister of Research and Technology (Menristek) and head of the Strategic Industries Management Agency (BPIS), presiding over shipyards, munitions plants, steelworks, and the Batam industrial zone. Championed by Suharto as a surrogate son, Habibie clashed repeatedly with Berkeley-trained finance technocrats over state subsidies for his crowning ambition: the indigenous, fly-by-wire N-250 [i]Gatotkaca[/i] turboprop, whose maiden flight on August 10, 1995, became the centerpiece of the Republic's fiftieth independence anniversary. In December 1990, with Suharto's blessing, he became founding chairman of the Association of Indonesian Muslim Intellectuals (ICMI), transforming a network of modernist Muslim scholars and bureaucrats into a formidable counterweight to the secular-nationalist military brass inside Golkar. When Suharto tapped him as the nation's seventh Vice President in March 1998 at the height of the Asian Financial Crisis, foreign currency markets recoiled at his reputation for big-ticket industrial spending. Ten weeks later—after Suharto spurned him on the eve of stepping down—Habibie was sworn in as President at Merdeka Palace on the morning of May 21, 1998, tasked with dismantling from within the authoritarian edifice that had sheltered his entire career, stabilizing a shattered economy, and fighting for legitimacy before a parliament that viewed him as an accidental caretaker.",
	"bio.habibie.title": "B.J. Habibie",
	"category.civil_society": "Civil Society",
	"category.economy": "Economy",
	"category.politics": "Politics",
	"category.regional_affairs": "Regional Affairs",
	"category.security": "Security",
	"changelog.0.date": "2 November 2026",
	"changelog.0.note.0": "This update adds an experimental Golkar interaction, reworked mobile UI interface and fixes a long list of gameplay bugs, mismatched achievements and leftover code.",
	"changelog.0.note.1": "[b]NEW CONTENT[/b]\n\n• The Golkar faction screens now show three large letters, [b]A[/b] (ABRI), [b]B[/b] (Bureaucracy) and [b]G[/b] (Golkar). Tap a letter to read about it and which decree breaks it.",
	"changelog.0.note.2": "[b]NEW CAMPAIGN:[/b]\n\n• After choosing a difficulty, [i]The Current Situation[/i] now asks whether you want the full briefing ([i]\"I want to learn what happened!!\"[/i]) or to start immediately ([i]\"Just let me play!\"[/i])",
	"changelog.0.note.3": "[b]MOBILE[/b]\n\n• A whole assortment of fixes and improvements..",
	"changelog.0.note.4": "[b]GAMEPLAY FIXES[/b]\n\n• [b]FINAL APPEALS:[/b] They now open on the Accountability Speech and the Night of the Long Knives, instead of being tied to the final turn, which has no action phase. [i]Halo, Halo Senayan[/i] now needs two Final Appeals, the most a run can use.\n• [b]VICTORY:[/b] Winning the vote now always requires [b]351 of 700[/b] votes, even when factions were banned.\n• [b]MILITARY:[/b] An effect that listed both [i]mil[/i] and [i]abri[/i] no longer applies both (no longer applies 2x the effect)\n• [b]DECREES:[/b] Mutually exclusive decrees now block each other in both directions.\n• [b]ACHIEVEMENTS:[/b] [i]Voice of the People[/i] now unlocks at the \"Tolerated\" popularity tier it names.",
	"changelog.0.note.5": "[b]FIXES:[/b] Fixed the music player not looping when only one track is available in a genre, and a misspelled style name on the vote result paper. Removed legacy codes.",
	"changelog.0.title": "Beta 0.2.1 Hotfix",
	"changelog.1.date": "30 October 2026",
	"changelog.1.note.0": "This version introduces Indonesian localization alongside a major rework of difficulty, opposition mechanics, gameplay balance, UI, music, and code cleanup.",
	"changelog.1.note.1": "[b]NEW CONTENT[/b]\n\n• [b]SEVERE STATE SITUATIONS (SSS):[/b] Beat Historical to unlock a 24-card custom crisis board. Win with every situation card at Level III to unlock the [i]Bragging Rights[/i] achievement.\n• [b]PDI-P OPPOSITION:[/b] Added a Street Mobilization bar to the PDI-P faction screen.\n• [b]MILITARY OPPOSITION:[/b] Added a Patience and Anger bar to the Military faction screen.\n• [b]ACHIEVEMENTS:[/b] Expanded to 66 achievements (31 new) across reformist, authoritarian, stat, and faction paths, and fixed the [i]Bragging Rights[/i] unlock trigger.\n• [b]MUSIC PLAYER:[/b] Added genre filters (National, Critique, Pop, International) and direct seek and volume sliders on the dashboard.",
	"changelog.1.note.2": "[b]DIFFICULTY[/b]\nUpdated and reworked. Beyond starting [color=__STAT_PC__]Political Capital[/color], [color=__STAT_CENDANA__]Cendana Influence[/color], [color=__CLR_DARK_RED__]Maluses[/color], [color=__STAT_PC__]PC[/color] action costs, and military anger, each difficulty now also scales delegate defection rates, chamber volatility, event outcomes, and faction leverage:\n\n• [b]Easy:[/b] 75 PC, +15 to starting stats, Cendana at 40. Decrees and faction deals cost 10% less, bad events hurt 25% less, and faction deals pay 15% more.\n• [b]Medium:[/b] 50 PC, +5 to stats, Cendana at 60, +1 PC/turn. Good events are 8% stronger and faction deals pay 15% more.\n• [b]High:[/b] 35 PC, no stat bonus, Cendana at 75. Slightly higher action costs, bad events hit 5% harder, and Cendana slowly regenerates.\n• [b]Historical:[/b] 20 PC, Cendana at 95, +15% action costs (+2 PC on every faction deal). Bad events hit 10% harder, good events are 5% weaker, favors are capped at 2 per faction, and all cooldowns last 1 turn longer.",
	"changelog.1.note.3": "[b]GAMEPLAY[/b]\n\n• [b]STATS:[/b] Faction support above baseline slowly erodes each turn unless maintained, high stats gravitate toward neutral (and low stats nudge upward on Easy/Medium), and Cendana regenerates toward its starting strength.\n• [b]ELECTION:[/b] Added difficulty-scaled mood swings, wildcard shocks, aisle-crossing, and secret-ballot betrayal during the final vote.\n• [b]LEVERAGE:[/b] Faction leverage now scales cost and gain multipliers gradually instead of jumping at fixed tiers.\n• [b]DECREES:[/b] Stat and loyalty floors guaranteed by decrees now ramp up each turn instead of locking instantly.\n• [b]ROUTINE:[/b] Repeating the same Routine Action or Faction Deal now yields diminishing PC and weaker effects.\n• [b]FAVORS:[/b] Banked favors per faction are now capped by difficulty.",
	"changelog.1.note.4": "[b]REBALANCE[/b]\n\n• [b]ACTIONS & EVENTS:[/b] Reworked Decrees, Routine Actions, Faction Deals, and Events to fit the new difficulty curve, nerfed overpowered options, and softened Medium difficulty.\n• [b]OPPOSITION:[/b] Balanced Military and PDI-P impacts across events and actions; extreme decrees now deal direct shock to Military patience, while high Military loyalty slows and drains anger.\n• [b]POLITICAL CAPITAL:[/b] Capped passive PC earnings at 10 PC, made stability maluses take a proportional share of routine PC gains instead of a flat cut, and capped combined Military/PDI-P PC reductions at 40%.",
	"changelog.1.note.5": "[b]UI & CLEANUP[/b]\n\n• [b]VISUALS:[/b] Added new themes (Merah Putih, Rainbow, Rainbow swirl, Twilight, Kopi, Solarized), added a glossy glass overlay to images, enlarged the \"In Memoriam photo,\" and colored Poros Tengah green once formed.\n• [b]TEXT & ALERTS:[/b] Trimmed events, factions, and decrees to two paragraphs max, justified faction descriptions, standardized all stat names, and color-coded meter text and new-interaction alerts.\n• [b]UNDER THE HOOD:[/b] Cleaned up Library formatting, unified stat and stance strings for localization, removed legacy loading/tooltip code, and fixed minor bugs and typos.",
	"changelog.1.note.6": "[b]REMOVED[/b]\n\n• Removed the Cilangkap Pact, achievement images, and the street mobilization line and tooltips from the presidential agenda.",
	"changelog.1.title": "Beta 0.2 \"Rekayasa Politik\"",
	"changelog.2.date": "October 21, 2026",
	"changelog.2.note.0": "The military now coordinate with the other factions to oust you if you piss them off, they also let people protest and scapegoat minorities.",
	"changelog.2.note.1": "PDIP and Central Axis are reluctant to be in the same coalition.",
	"changelog.2.note.10": "Small rebalancing.",
	"changelog.2.note.11": "Decluttered settings by making color schemes be a dropdown.",
	"changelog.2.note.2": "dissolving seats affect your credibility among the delegates, and they may not appear during the vote.",
	"changelog.2.note.3": "Reworked opposition AI (Placeholder for later updates).\n\n• [color=__CLR_BRIGHT_RED__]There are no popups yet, but Megawati, Rais, and Wiranto is fucking over your administration in the backgrond.[/color]",
	"changelog.2.note.4": "Added placeholder for localisation rework.",
	"changelog.2.note.5": "Rewrote faction information to be more concise.",
	"changelog.2.note.6": "Changed Golkar loyalist portrait with A.A Baramuli.",
	"changelog.2.note.7": "Changed Golkar loyalist name from Irama Tersedak to Irama Suka Nusantara (Irian Jaya, Maluku, Sumatra, Sulawesi, Kalimantan, and Nusa Tenggara).",
	"changelog.2.note.8": "Improved some election UI.",
	"changelog.2.note.9": "Download Results now show enacted decrees.",
	"changelog.2.title": "Beta 0.1.3 Hotfix",
	"changelog.3.date": "October 20, 2026",
	"changelog.3.note.0": "General Wiranto’s patience is no longer infinite: Leave Cilangkap out in the cold, and troops will happily stay in their barracks while the streets burn.",
	"changelog.3.note.1": "Amien Rais and Gus Dur remembered they control 163 seats and don't work for you.",
	"changelog.3.note.2": "Akbar Tandjung caught on to your weekly blackmail routine.",
	"changelog.3.note.3": "Taufik Kiemas has had enough free coffee.",
	"changelog.3.note.4": "Increased betrayal.",
	"changelog.3.title": "Beta 0.1.2 Hotfix",
	"changelog.4.date": "October 19, 2026",
	"changelog.4.note.0": "[b]Amien Rais and Gus Dur will no longer blindly hand you the presidency:[/b] Coalition favors are now taxed on merge, and final appeal favor-dumping has heavy diminishing returns.",
	"changelog.4.note.1": "[b]Infinite PC button patched:[/b] Slashed base Political Capital payouts across routine actions so you can't just print 300+ PC like an ATM.",
	"changelog.4.note.2": "[b]PDI-P will literally burn the capital down and then crucify you:[/b] Freezing out Megawati into deep hostility now triggers massive red-shirt demonstrations, bleeding National Stability and spooking regional delegates.\n\n• Added a 'Street Mobilization' indicator to PDI-P's screen so you can see how close the Satgas is to rioting before things explode.",
	"changelog.4.note.3": "[b]Cendana actually does something instead of sleeping:[/b] Nuking Suharto's family influence too fast in a single turn now causes liquidity runs and street-level sabotage.",
	"changelog.4.note.4": "Reunifying Golkar under Slipi sets a reasonable floor instead of permanently making him 100% loyal.",
	"changelog.4.title": "Beta 0.1.1 Hotfix",
	"changelog.5.date": "October 19, 2026",
	"changelog.5.note.0": "Expect some bugs and missing features, but the game is playable and the core mechanics are in place.\n[color=__CLR_BRIGHT_RED__]This is a beta release, so please report any bugs you find!\nNotes: \n\n• Missing images\n• Some untested features\n• Broken display\n[/color]\n\n[color=__CLR_NAVY__][/color]",
	"changelog.5.title": "Beta Release \"Pidato Pertanggungjawaban\"",
