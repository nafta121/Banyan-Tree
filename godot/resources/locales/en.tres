	"stat.recent_shift": "Recent shift",
	"stat.tier_fallback": "a stable level",
	"stat.unknown": "Unknown",
	"status.cendana_whip.high": "Emissaries from Jalan Cendana are moving through the Hotel Mulia suites.",
	"status.cendana_whip.low": "Jalan Cendana's patronage network is crippled.",
	"tap.article1": "The Accountability of the President of the Republic of Indonesia, [b]Prof. Dr. Ing. Bacharuddin Jusuf Habibie[/b], delivered before the 8th Plenary Meeting on October 14, 1999, together with the President's reply to the General Views of the Factions before the 11th Plenary Meeting on October 17, 1999 at the General Session of the People's Consultative Assembly, is hereby declared $VERDICT$.",
	"tap.article1_heading": "Article 1",
	"tap.article2": "This Decree shall enter into force on the date of its enactment.",
	"tap.article2_heading": "Article 2",
	"tap.chairman": "PEOPLE'S CONSULTATIVE ASSEMBLY OF THE REPUBLIC OF INDONESIA\nCHAIRMAN,",
	"tap.chairman_name": "Prof. Dr. H. M. Amien Rais, M.A.",
	"tap.concerning": "CONCERNING\n\nTHE ACCOUNTABILITY OF THE PRESIDENT OF THE REPUBLIC OF INDONESIA\nProf. Dr. Ing. BACHARUDDIN JUSUF HABIBIE",
	"tap.considering.a": "that the President elected and appointed by the People's Consultative Assembly of the Republic of Indonesia is subordinate and accountable to the Assembly and, at the conclusion of his term, delivers an accounting for the implementation of the Outlines of State Policy established by the 1945 Constitution and/or by the Assembly;",
	"tap.considering.b": "that Prof. Dr. Ing. Bacharuddin Jusuf Habibie has held office as President of the Republic of Indonesia since taking the oath of office on May 21, 1998;",
	"tap.considering.c": "that the President of the Republic of Indonesia Prof. Dr. Ing. Bacharuddin Jusuf Habibie delivered his Accountability Speech before the 8th Plenary Meeting on October 14, 1999, and his formal reply to the General Views of the Factions before the 11th Plenary Meeting on October 17, 1999;",
	"tap.considering.d": "that the People's Consultative Assembly must evaluate and render a binding decision upon the accountability of President Prof. Dr. Ing. Bacharuddin Jusuf Habibie during his tenure in office.",
	"tap.considering_heading": "Considering:",
	"tap.decides": "DECIDES",
	"tap.decree_title": "DECREE OF THE PEOPLE'S CONSULTATIVE ASSEMBLY\nOF THE REPUBLIC OF INDONESIA\nNUMBER III/MPR/1999",
	"tap.enacted": "Enacted in Jakarta\non October 19, 1999",
	"tap.garuda_alt": "[Garuda]",
	"tap.grace": "BY THE GRACE OF GOD ALMIGHTY\nTHE PEOPLE'S CONSULTATIVE ASSEMBLY OF THE REPUBLIC OF INDONESIA,",
	"tap.observed": "[b]Having Observed:[/b] The deliberations of Commission D (October 17–18, 1999) and the secret-ballot decision of the 12th Plenary Meeting on October 19–20, 1999 ($FOR$ Accept, $AGAINST$ Reject, $BLANK$ Blank votes).",
	"tap.org": "PEOPLE'S CONSULTATIVE ASSEMBLY OF THE REPUBLIC OF INDONESIA",
	"tap.signed": "[Signed]",
	"tap.to_enact": "[b]To Enact:[/b] DECREE OF THE PEOPLE'S CONSULTATIVE ASSEMBLY OF THE REPUBLIC OF INDONESIA CONCERNING THE ACCOUNTABILITY OF THE PRESIDENT OF THE REPUBLIC OF INDONESIA Prof. Dr. Ing. BACHARUDDIN JUSUF HABIBIE.",
	"tap.vice_chairmen": "Prof. Dr. Ir. Ginandjar Kartasasmita • Drs. Kwik Kian Gie • H. Matori Abdul Djalil • Drs. H. M. Husnie Thamrin • Hari Sabarno, S.IP., M.B.A., M.M. • Prof. Dr. Jusuf Amir Feisal, S.Pd. • Drs. H. A. Nazri Adlani",
	"tap.vice_chairmen_label": "VICE CHAIRMEN:",
